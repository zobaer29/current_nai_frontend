# ==========================================
# CurrentNai Frontend Environment Template
# Copy this file to .env and fill in your custom values
# ==========================================

# Data Source & Mode Configuration (true / false)
VITE_USE_MOCK_DATA=true

# Backend API Endpoints
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_SERVER_URL=ws://localhost:5000

# Map Tiles & Render Configuration
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://carto.com/attributions">CARTO</a>

# Optional External API Keys (Mapbox / LocationIQ / Geocoding)
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
VITE_GEOCODING_API_KEY=your_geocoding_api_key_here

# Default Map Viewport Coordinates (Dhaka, Bangladesh)
VITE_DEFAULT_LAT=23.8069
VITE_DEFAULT_LNG=90.3687
